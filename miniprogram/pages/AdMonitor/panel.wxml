<!-- pages/AdMonitor/panel.wxml -->
<view class="container">
  <l-transition show="{{ true }}" name="fade-down">
    <view class="panel">
      <view class="tools-btn">
        <l-button l-class="tool-button" l-icon-class="tool-button-icon" shape="semicircle" size="mini" plain="{{true}}" bind:lintap="swicthTypeHandler" id="{{current_type.key}}">{{current_type.value}}</l-button>
        <l-button l-class="tool-button setting-btn" l-icon-class="tool-button-icon" icon="setting" icon-color="aqua" icon-size="18rpx" special="{{true}}" size="mini" shape="semicircle" plain="{{true}}" bind:lintap="showSettingPanel">
          <l-icon name="setting" color="aqua" l-class="tool-button-icon" />
        </l-button>
      </view>
      <view class="panel__total">
        <view class="panel__show" wx:if="{{showLoading}}">
          <l-loading show="{{true}}" type="change" color="#fff"></l-loading>
        </view>
        <view class="panel__show" wx:else>
          <view class="panel__money">
            <l-price unit="¥" autofix="{{true}}" reserve-digit="2" unit-color="var(--white)" value-color="var(--white)" unit-size="40" value-size="70" value="{{ statistics.costCny }}"></l-price>
          </view>
          <view class="panel__money">
            <l-price unit="NT$" autofix="{{true}}" reserve-digit="2" unit-color="var(--white)" value-color="var(--white)" unit-size="26" value-size="40" value="{{ statistics.cost }}"></l-price>
          </view>
        </view>
      </view>
      <!-- 日期选择 -->
      <view class="panel_date">
        <!-- 日期选择器 -->
        <date isShow="{{isShowDateCheck}}" minDate="2022/05/01" timeStart="{{start_date}}" timeEnd="{{end_date}}" theme_color="#00c9ec" bind:tapYes="dateSubmit" bind:tapNo="closeDateCheck" id="dateRange" currentDate="2022/05/01" />
        <!-- 日期选择器end -->
        <!-- 日期范围 -->
        <view class="panel_picker_date">
          <view class="panel_picker_date_content" bindtap="showDateCheck">
            <view class="panel_picker_date_box">
              <text class="iconfont icon-calendar"></text>
              <view class="picker_date">{{start_date}}</view>
              <text class="picker_date_center">:</text>
              <view class="picker_date">{{end_date}}</view>
            </view>
          </view>
        </view>
        <!-- 日期范围end -->
      </view>
      <!-- 时间选择end -->
    </view>
  </l-transition>
  <!-- 标签页 -->
  <view class="tabs_container">
    <l-tabs bind:linchange="onTabsChannelChangeEvent" animated="{{false}}" animated-for-line="{{false}}" swipeable="{{false}}" scrollable="{{false}}" has-line="{{false}}" l-header-class="tabs_view" l-active-class="tabs_active" l-inactive-class="tabs_noactive" l-content-class="tabs_content" l-tabimage-class="tabs_img">
      <!-- 渠道选择 -->
      <block wx:for="{{channels}}" wx:key="id" wx:for-item="channelInfo">
        <l-tabpanel tab="{{channelInfo.channelDetail.name}}" key="{{channelInfo.id}}" slot="{{channelInfo.id}}">
          <view class="tab-content">
            <!-- style手风琴 -->
            <l-collapse type='accordion'>
              <l-collapse-item title="账号列表">
                <l-checkbox-group bind:linchange="onCheckAccountHandler">
                  <!-- 账号选择 -->
                  <l-checkbox wx:for-items="{{channelInfo.accounts}}" wx:for-item="account" wx:key="id" min-selected="{{1}}" key="{{account.id}}" checked="{{account.isChecked}}" disabled="{{account.disabled}}" select-color="var(--primary)" l-class="checkbox-style">
                    {{account.accountDetail.name}}
                  </l-checkbox>
                  <!-- 账号选择end -->
                </l-checkbox-group>
              </l-collapse-item>
            </l-collapse>
            <!-- style手风琴end -->
          </view>
        </l-tabpanel>
      </block>
      <!-- 渠道选择end -->
    </l-tabs>
  </view>
  <!-- 标签页end -->
  <l-transition show="{{true}}" name="fade-up">
    <view class="panel_details">
      <view class="panel_content">
        <view class="adaccount_box">
          <text class="adaccount">Recent Ad statistics</text>
        </view>
        <view class="panel_empty" wx:if="{{showMessage}}">
          <l-icon name="{{message.name}}" color="{{message.color}}" />
          <text class="alert" style="color:{{message.color}}">{{message.content}}</text>
        </view>
        <view class="statistics" wx:else>
          <view class="statistics_list">
            <view class="statistics_item">
              <view class="name">
                <text class="iconfont icon-survey"></text>
                <text>Cost</text>
              </view>
              <view class="drawLinebox">
                <view class="drawLine"></view>
              </view>
              <view class="value">{{statistics.cost}}</view>
            </view>
            <view class="statistics_item">
              <view class="name">
                <text class="iconfont icon-survey"></text>
                <text>Imp</text>
              </view>
              <view class="drawLinebox">
                <view class="drawLine"></view>
              </view>
              <view class="value">{{statistics.imp}}</view>
            </view>
            <view class="statistics_item">
              <view class="name">
                <text class="iconfont icon-survey"></text>
                <text>Click</text>
              </view>
              <view class="drawLinebox">
                <view class="drawLine"></view>
              </view>
              <view class="value">{{statistics.click}}</view>
            </view>
            <view class="statistics_item">
              <view class="name">
                <text class="iconfont icon-survey"></text>
                <text>Ctr</text>
              </view>
              <view class="drawLinebox">
                <view class="drawLine"></view>
              </view>
              <view class="value">{{statistics.ctr}}</view>
            </view>
            <view class="statistics_item">
              <view class="name">
                <text class="iconfont icon-survey"></text>
                <text>Cv</text>
              </view>
              <view class="drawLinebox">
                <view class="drawLine"></view>
              </view>
              <view class="value">{{statistics.cv}}</view>
            </view>
            <view class="statistics_item">
              <view class="name">
                <text class="iconfont icon-survey"></text>
                <text>Cvr</text>
              </view>
              <view class="drawLinebox">
                <view class="drawLine"></view>
              </view>
              <view class="value">{{statistics.cvr}}</view>
            </view>
            <view class="statistics_item">
              <view class="name">
                <text class="iconfont icon-survey"></text>
                <text>Cpa</text>
              </view>
              <view class="drawLinebox">
                <view class="drawLine"></view>
              </view>
              <view class="value">{{statistics.cpa}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </l-transition>
  <l-arc-popup l-panel-class="arc-popup-panel" l-bg-class="arc-popup-bg" l-header-class="arc-popup-head" show="{{showSetting}}" direction="bottom" min-height="{{600}}" opacity="0.3" header-fixed="{{true}}" >
    <view class="setting-panel">
      <view slot="header" class="header-content">
        <text>监控状态管理</text>
        <l-icon name="down" size="36" color="#ccc" bindtap="hideSettingPanel"></l-icon>
      </view>
      <!-- 内容区 -->
        <!-- 折叠组 -->
        <l-collapse type='accordion'>
          <view class="setting-item-list" wx:for="{{channel_list}}" wx:for-index="cidx" wx:for-item="channel" wx:key="id">
            <view class="setting-item">
              <!-- 渠道 -->
              <view class="setting-item-title">
                <view style="color: var(--primary);">{{channel.channelDetail.name}}渠道</view>
                <l-switch checked="{{channel.channelDetail.status}}" color="#e0e0e0" id="{{channel.id}}" select-color="var(--primary)" bind:linchange="channelStatusSwitch" />
              </view>
              <!-- 渠道end -->
              <!-- 折叠 -->
              <l-collapse-item title="" l-class="collstyle">
                <view class="space-item"></view>
                <!-- 子账户 -->
                <view class="setting-item-content" wx:for="{{account_list}}" wx:for-index="aidx" wx:for-item="account" wx:key="id">
                  <view wx:if="{{account.accountDetail.channelId === channel.id}}" class="setting-account">
                    <l-switch checked="{{account.accountDetail.status}}" color="#e0e0e0" select-color="var(--tertiary)" bind:linchange="accountStatusSwitch" id="{{account.id}}" />
                    <view class="account-name">{{account.accountDetail.name}}</view>
                  </view>
                </view>
                <!-- 子账户end -->
              </l-collapse-item>
              <!-- 折叠end -->
            </view>
          </view>
        </l-collapse>
        <!-- 折叠组end -->
      <!-- 内容区end -->
    </view>
  </l-arc-popup>
</view>